{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    },
    "api/[[...chronoRoute]].ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:chronoRoute*",
      "destination": "/api/index?__chrono_path=:chronoRoute*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
